#!/usr/bin/env python3

import os
import sys
import json
import shlex
import subprocess


def get_compile_commands_location():
    cwd = os.getcwd()
    possible_locations = [".", "build"]

    while True:
        for location in possible_locations:
            lookup = os.path.join(cwd, location, "compile_commands.json")

            if os.path.isfile(lookup):
                return os.path.realpath(lookup)

        parent = os.path.dirname(cwd)
        if parent == cwd:
            return None
        cwd = parent


def expand_response_files(args, directory, seen=()):
    result = []
    for arg in args:
        if not arg.startswith("@"):
            result.append(arg)
            continue
        path = os.path.realpath(os.path.join(directory, arg[1:]))
        if path in seen:
            raise ValueError(f"Recursive response file: {path}")
        with open(path, encoding="utf-8") as response:
            nested = shlex.split(response.read())
        result.extend(expand_response_files(nested, directory, (*seen, path)))
    return result


def prettify_arguments(args, filename=None, directory=None):
    directory = directory or os.getcwd()
    filename = os.path.realpath(filename) if filename else None
    result = []
    args = iter(expand_response_files(args[1:], directory))
    # Keep values intact, even when a value happens to equal the source filename.
    value_flags = {
        "-I", "-isystem", "-iquote", "-idirafter", "-include", "-imacros",
        "-isysroot", "--sysroot", "-target", "--target", "-x", "-D", "-U",
        "-Xclang", "-Xpreprocessor", "-B", "-resource-dir", "-gcc-toolchain",
        "--gcc-toolchain", "-iprefix", "-iwithprefix", "-iwithprefixbefore",
    }
    for arg in args:
        if arg in {"-o", "-MF", "-MT", "-MQ", "-MJ"}:
            next(args)  # Drop build outputs, not compiler configuration.
        elif arg in {"-c", "-S", "-E", "-Werror", "-MD", "-MMD", "-MP", "-MG"}:
            continue
        elif arg.startswith(("-MF", "-MT", "-MQ", "-MJ")) or (
            arg.startswith("-o") and not arg.startswith(("-objc", "-object", "-offload", "-openmp"))
        ):
            continue
        elif arg in value_flags:
            result.extend((arg, next(args)))
        elif filename and not arg.startswith("-") and os.path.realpath(os.path.join(directory, arg)) == filename:
            continue
        else:
            result.append(arg)
    return result


def get_compile_arguments(compile_commands, needed_file):
    with open(compile_commands, encoding="utf-8") as cmds:
        commands = json.load(cmds)
    for command in commands:
        directory = os.path.realpath(os.path.join(os.path.dirname(compile_commands), command["directory"]))
        filename = os.path.realpath(os.path.join(directory, command["file"]))
        if filename == os.path.realpath(needed_file):
            args = command.get("arguments")
            if args is None:
                args = shlex.split(command["command"])
            return prettify_arguments(args, filename, directory), directory
    return None, None


ANALYZER_CHECKERS = [
    "core",
    "cplusplus",
    "fuchsia",
    "nullability",
    "optin",
    "security",
    "unix",
    "valist",
]


def main(filenames):
    compile_commands = get_compile_commands_location()
    if not compile_commands:
        return 0
    result = 0
    for filename in filenames:
        filename = os.path.realpath(filename)
        args, directory = get_compile_arguments(compile_commands, filename)
        if args is None:
            print(f"Skip not found file {filename}", file=sys.stderr)
            continue
        cmd = [
            "clang", "--analyze", "-Xclang",
            "-analyzer-checker=" + ",".join(ANALYZER_CHECKERS),
            *args, filename,
        ]
        if os.getenv("VERBOSE"):
            print(f">> run {shlex.join(cmd)} in {directory}", file=sys.stderr)
        ret = subprocess.run(cmd, check=False, cwd=directory)
        if ret.returncode:
            result = ret.returncode if ret.returncode > 0 else 128 - ret.returncode
    return result


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError, KeyError, StopIteration) as error:
        print(f"clang-analyzer: {error}", file=sys.stderr)
        sys.exit(1)
